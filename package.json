{
  "name": "itemdb",
  "version": "1.0.0",
  "description": "Neopets Open Source Item Database",
  "keywords": [],
  "license": "MPL-2.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "next dev --turbopack",
    "build": "npx prisma generate && next build",
    "build:app": "next build",
    "build-turbo": "npx prisma generate && next build --turbopack",
    "build-proxy": "npx prisma generate --data-proxy && next build",
    "build-intl": "",
    "build-intl-off": "npx --yes github:lucca180/itemdb-intl-compiler ./pages --output ./translation/tree-shake/pages/ -t ./ && npx --yes github:lucca180/itemdb-intl-compiler ./app --output ./translation/tree-shake/app -t ./",
    "test": "vitest",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc",
    "typecheck:fast": "node ./node_modules/typescript-7/bin/tsc",
    "typecheck:legacy": "tsc",
    "start": "PORT=4000 next start",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "prettier": "prettier --write .",
    "postbuild": "next-sitemap",
    "dump:tables": "tsx scripts/dump-tables-to-r2.ts"
  },
